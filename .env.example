# InsureFlow AI Agent - Environment Configuration

# OpenAI API Key (Required for NLU, Function Calling, and Advice Generation)
OPENAI_API_KEY=your_openai_api_key_here

# Pinecone Vector DB (Required for RAG Playbook Search)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=sales-playbook
PINECONE_NAMESPACE=sales-playbook-v1

# Redis Cloud / Local In-Memory Store (Optional - falls back to local in-memory store if unavailable)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# WebSocket Orchestrator & Server Ports
ORCHESTRATOR_WS_URL=ws://localhost:8000/stream
AGENT_PORT=5051
CHUNK_BUFFER_SECONDS=1.5
